// Indefine LMS — Prisma schema
// Designed for ~16 internal users on Railway Postgres.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------- Auth (NextAuth/Auth.js) --------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(EMPLOYEE)
  createdAt     DateTime  @default(now())

  accounts      Account[]
  sessions      Session[]

  progresses    VideoProgress[]
  attempts      QuizAttempt[]
}

enum Role {
  EMPLOYEE
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -------------------- Learning content --------------------

model Course {
  id          String   @id @default(cuid())
  title       String
  description String?
  order       Int      @default(0)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules     Module[]
  deadlines   Deadline[]
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  order       Int      @default(0)

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  videos      Video[]
}

model Video {
  id              String   @id @default(cuid())
  moduleId        String
  title           String
  description     String?
  // Microsoft Graph identifiers — driveId + itemId let us re-fetch fresh stream URLs
  graphDriveId    String
  graphItemId     String
  durationSeconds Int?
  order           Int      @default(0)
  createdAt       DateTime @default(now())

  module          Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  quiz            Quiz?
  progresses      VideoProgress[]
}

model VideoProgress {
  id              String   @id @default(cuid())
  userId          String
  videoId         String
  watchedSeconds  Int      @default(0)
  lastPosition    Int      @default(0)
  percent         Float    @default(0)
  completed       Boolean  @default(false)
  completedAt     DateTime?
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video           Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
}

// -------------------- Quizzes --------------------

model Quiz {
  id              String   @id @default(cuid())
  videoId         String   @unique
  title           String
  timeLimitSec    Int      @default(300) // whole-quiz timer
  passPercent     Int      @default(70)
  maxAttempts     Int?     // null = unlimited
  unlockAtPercent Int      @default(90) // % of video that must be watched

  video           Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  questions       Question[]
  attempts        QuizAttempt[]
}

model Question {
  id        String   @id @default(cuid())
  quizId    String
  text      String
  order     Int      @default(0)
  points    Int      @default(1)

  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options   Option[]
}

model Option {
  id         String   @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id           String   @id @default(cuid())
  userId       String
  quizId       String
  score        Int      @default(0)
  maxScore     Int      @default(0)
  percent      Float    @default(0)
  passed       Boolean  @default(false)
  startedAt    DateTime @default(now())
  submittedAt  DateTime?
  // JSON of { questionId: optionId } answers
  answers      Json?

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz         Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

// -------------------- Deadlines / KRA --------------------

model Deadline {
  id         String        @id @default(cuid())
  courseId   String
  kind       DeadlineKind  @default(CUSTOM)
  dueAt      DateTime
  // points awarded toward KRA when completed on time
  pointsOnTime Int         @default(10)
  pointsLate   Int         @default(0)

  course     Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

enum DeadlineKind {
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}
