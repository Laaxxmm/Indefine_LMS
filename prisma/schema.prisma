// Indefine LMS — Prisma schema
// Designed for ~16 internal users on Railway Postgres.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------- Auth (NextAuth/Auth.js) --------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(EMPLOYEE)
  level         EmployeeLevel @default(EXECUTIVE)
  department    Department    @default(GENERAL)
  branchId      String?
  managerId     String?
  active        Boolean   @default(true)
  deactivatedAt DateTime?
  // Shared / functional mailboxes (accounts@, info@, team inboxes) that sync in
  // from M365 but aren't real people — kept for invites/email, excluded from the
  // leaderboard, grading and the assignment picker.
  excludedFromScoring Boolean @default(false)
  // Growth Wizard self-reflection — populated through the multi-step flow
  strengths           Json?     // string[]
  aspiration          String?   // free-text "where do you see yourself in 12mo"
  wizardSubmittedAt   DateTime?
  createdAt     DateTime  @default(now())

  accounts      Account[]
  sessions      Session[]

  progresses    VideoProgress[]
  attempts      QuizAttempt[]

  assignments        Assignment[] @relation("AssignmentTarget")
  assignmentsCreated Assignment[] @relation("AssignmentCreator")

  manager       User?    @relation("Reports", fields: [managerId], references: [id])
  reports       User[]   @relation("Reports")
  branch        Branch?  @relation(fields: [branchId], references: [id])

  // Trajectory
  quests              Quest[]
  questsApproved      Quest[]      @relation("QuestApprover")
  initiatives         Initiative[]
  initiativeReactions InitiativeReaction[]
  endorsementsGiven   Endorsement[] @relation("EndorseFrom")
  endorsementsGot     Endorsement[] @relation("EndorseTo")
  checkins            WeeklyCheckin[]
  trackSnapshots      TrackSnapshot[]
  tierAssignments     TierAssignment[]
  attendances         AttendanceRecord[]
  liveSessions        LiveSession[]   @relation("LiveSessionOrganizer")
  liveAttendances     LiveAttendance[]
  videosCreated       Video[]         @relation("VideoCreator")
  certificateIssues   CertificateIssue[] @relation("CertificateCreator")
  officeToolRuns      OfficeToolRun[]    @relation("OfficeToolRunner")
}

enum EmployeeLevel {
  // Legacy values kept so existing rows don't break — UI hides these.
  TRAINEE        @map("TRAINEE")
  ASSOCIATE      @map("ASSOCIATE")
  SENIOR         @map("SENIOR")
  LEAD           @map("LEAD")
  // CA-firm canonical levels
  ARTICLE
  EXECUTIVE
  SENIOR_EXECUTIVE
  ASSISTANT_MANAGER
  MANAGER
  SENIOR_MANAGER
  PARTNER
}

enum Department {
  AUDIT
  TAX
  ACCOUNTS
  ROC
  TECH       // internal technology / engineering team
  ADMIN      // operations / hr / finance / front office
  GENERAL    // fallback / not-yet-assigned
}

enum Role {
  EMPLOYEE
  ADMIN
}

// Physical office location. Lets the firm scale across cities and
// compare branch performance side-by-side.
model Branch {
  id        String   @id @default(cuid())
  name      String   // "Bangalore HQ"
  code      String   @unique  // short code "BLR" used in lists
  city      String?
  state     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users     User[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -------------------- Learning content --------------------

model Course {
  id          String   @id @default(cuid())
  title       String
  description String?
  order       Int      @default(0)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules     Module[]
  deadlines   Deadline[]
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  order       Int      @default(0)

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  videos      Video[]
  assignments Assignment[]
}

model Video {
  id              String   @id @default(cuid())
  moduleId        String
  title           String
  description     String?
  // Pasted script / notes (e.g. the NotebookLM source) used to ground AI quiz
  // generation. Saving this triggers an auto-generated 20-question quiz.
  sourceText      String?  @db.Text
  // Microsoft Graph identifiers — driveId + itemId let us re-fetch fresh stream URLs
  graphDriveId    String
  graphItemId     String
  durationSeconds Int?
  order           Int      @default(0)
  // Who added this content (credits the Initiative track). Set to the organizer
  // on a live-session recording; null for SharePoint-synced library videos.
  createdById     String?
  createdAt       DateTime @default(now())

  module          Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  createdBy       User?    @relation("VideoCreator", fields: [createdById], references: [id], onDelete: SetNull)
  quiz            Quiz?
  progresses      VideoProgress[]
  assignments     Assignment[]
}

model VideoProgress {
  id              String   @id @default(cuid())
  userId          String
  videoId         String
  watchedSeconds  Int      @default(0)
  lastPosition    Int      @default(0)
  percent         Float    @default(0)
  completed       Boolean  @default(false)
  completedAt     DateTime?
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video           Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
}

// -------------------- Quizzes --------------------

model Quiz {
  id              String   @id @default(cuid())
  videoId         String   @unique
  title           String
  timeLimitSec    Int      @default(300) // whole-quiz timer
  passPercent     Int      @default(70)
  maxAttempts     Int?     // null = unlimited
  unlockAtPercent Int      @default(90) // % of video that must be watched

  video           Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  questions       Question[]
  attempts        QuizAttempt[]
}

// App-wide settings (single row, id = 1). Holds the default quiz timing/pass
// applied to newly auto-generated quizzes.
model Settings {
  id                  Int      @id @default(1)
  quizTimeLimitSec    Int      @default(600) // 10 min
  quizPassPercent     Int      @default(70)
  quizUnlockAtPercent Int      @default(90)
  updatedAt           DateTime @updatedAt
}

model Question {
  id        String   @id @default(cuid())
  quizId    String
  text      String
  order     Int      @default(0)
  points    Int      @default(1)

  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options   Option[]
}

model Option {
  id         String   @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id           String   @id @default(cuid())
  userId       String
  quizId       String
  score        Int      @default(0)
  maxScore     Int      @default(0)
  percent      Float    @default(0)
  passed       Boolean  @default(false)
  startedAt    DateTime @default(now())
  submittedAt  DateTime?
  // JSON of { questionId: optionId } answers
  answers      Json?

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz         Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

// -------------------- Deadlines / KRA --------------------

model Deadline {
  id         String        @id @default(cuid())
  courseId   String
  kind       DeadlineKind  @default(CUSTOM)
  dueAt      DateTime
  // points awarded toward KRA when completed on time
  pointsOnTime Int         @default(10)
  pointsLate   Int         @default(0)

  course     Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

enum DeadlineKind {
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

// -------------------- Assignments --------------------

// Admin can assign two kinds of things to specific users:
//   VIDEO — links to a Video; auto-completes when the user watches it
//           (≥95%) AND passes its quiz (if one exists).
//   TASK  — free-text instruction. Admin marks complete manually.
// Each assignment carries its own KRA point value, which is awarded
// only when the assignment moves to COMPLETED.

model Assignment {
  id            String           @id @default(cuid())
  userId        String           // who it's assigned to
  assignedById  String           // admin who created it
  kind          AssignmentKind
  videoId       String?          // populated for VIDEO kind
  moduleId      String?          // populated for MODULE kind
  title         String           // shown in lists; for TASK this is the instruction
  description   String?
  points        Int              @default(0)
  dueAt         DateTime?
  status        AssignmentStatus @default(PENDING)
  completedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user        User    @relation("AssignmentTarget", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy  User    @relation("AssignmentCreator", fields: [assignedById], references: [id])
  video       Video?  @relation(fields: [videoId], references: [id], onDelete: SetNull)
  module      Module? @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([videoId])
  @@index([moduleId])
}

enum AssignmentKind {
  VIDEO
  MODULE
  TASK
}

enum AssignmentStatus {
  PENDING
  COMPLETED
}

// -------------------- Attendance (greytHR / Turia import) --------------------

// One row per employee per month, imported from the HR system's CSV export.
// Attendance % awards flat KRA points (same idea as Deadline points) that feed
// the leaderboard total in computeKraScores().
model AttendanceRecord {
  id            String   @id @default(cuid())
  userId        String
  periodMonth   DateTime // first day of the covered month, UTC midnight
  workingDays   Float    // total working / payable days in the period
  presentDays   Float    // days present (supports half-days)
  lateMarks     Int      @default(0)
  attendancePct Float    // presentDays / workingDays * 100, stored for transparency
  points        Int      // KRA points awarded for this month
  source        String   @default("greytHR")
  note          String?
  importedById  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodMonth])
  @@index([periodMonth])
}

// -------------------- Trajectory (performance OS) --------------------

// A "cycle" is a performance window (typically a financial year).
// Quarters Q1-Q4 are derived from the cycle's start date.
model PerformanceCycle {
  id        String   @id @default(cuid())
  name      String   // "FY 2026-27"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  targets         TrackTarget[]
  quests          Quest[]
  initiatives     Initiative[]
  trackSnapshots  TrackSnapshot[]
  tierAssignments TierAssignment[]
  checkins        WeeklyCheckin[]
}

enum TrackKind {
  MASTERY        // Auto: training compliance + best quiz scores
  DELIVERY       // Auto: task/module completion, on-time finishes
  INITIATIVE     // Self-log: initiatives kicked off, trainings led
  COLLABORATION  // Self-log: cross-team help, mentorship
  VISION         // Self-set: quarterly milestones on annual goals
  CRAFT          // Manager-rated: quality + soft skills
}

// Per-cycle, per-level target + weight for each track.
// Score per track is normalized: actual / target * 100, capped at 100.
// Total score is the weighted sum of all six.
model TrackTarget {
  id        String        @id @default(cuid())
  cycleId   String
  trackKind TrackKind
  level     EmployeeLevel
  target    Float         // raw value to score 100 (e.g. 12 modules)
  weight    Int           // % contribution to total tier score (0-100)

  cycle     PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([cycleId, trackKind, level])
}

enum TierKind {
  STELLAR        // 90-100
  SOARING        // 80-89
  SOLID          // 70-79
  GROWING        // 60-69
  FOCUSED        // 50-59
  RECALIBRATING  // < 50
}

enum QuestStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ACTIVE
  COMPLETED
  MISSED
}

model Quest {
  id          String      @id @default(cuid())
  userId      String
  cycleId     String
  title       String
  description String?
  why         String?     // why this matters to the employee
  weight      Int         @default(10)  // contributes to VISION track
  status      QuestStatus @default(DRAFT)
  approvedById String?
  approvedAt  DateTime?
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycle       PerformanceCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  approvedBy  User?             @relation("QuestApprover", fields: [approvedById], references: [id])
  milestones  QuestMilestone[]

  @@index([userId, cycleId])
  @@index([status])
}

model QuestMilestone {
  id          String    @id @default(cuid())
  questId     String
  title       String
  quarter     Int       // 1-4
  completed   Boolean   @default(false)
  completedAt DateTime?

  quest       Quest @relation(fields: [questId], references: [id], onDelete: Cascade)
}

enum InitiativeStatus {
  PITCHED
  FUNDED
  ACTIVE
  SHIPPED
  ARCHIVED
}

model Initiative {
  id          String           @id @default(cuid())
  userId      String
  cycleId     String
  title       String
  description String?
  impact      String?          // expected impact statement
  status      InitiativeStatus @default(PITCHED)
  fundedById  String?
  fundedAt    DateTime?
  shippedAt   DateTime?
  upvotes     Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycle       PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  reactions   InitiativeReaction[]

  @@index([cycleId, status])
}

enum ReactionKind {
  UPVOTE       // 🚀 generic support
  INTERESTED   // 🙋 count me in
}

model InitiativeReaction {
  id           String       @id @default(cuid())
  initiativeId String
  userId       String
  kind         ReactionKind @default(UPVOTE)
  createdAt    DateTime     @default(now())

  initiative Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([initiativeId, userId, kind])
  @@index([initiativeId])
}

enum EndorsementKind {
  COLLABORATION   // counts toward Collaboration track
  INITIATIVE      // counts toward Initiative track
  MENTORSHIP      // counts toward Collaboration track
  CROSS_DEPT      // counts toward Collaboration track
  CRAFT           // manager rating for Craft track (uses score 1-5)
}

model Endorsement {
  id         String          @id @default(cuid())
  fromId     String
  toId       String
  kind       EndorsementKind
  score      Int?            // 1-5 for CRAFT; null for count-based endorsements
  reason     String?
  approvedById String?       // for ones that need manager endorsement
  approvedAt DateTime?
  createdAt  DateTime        @default(now())

  from       User @relation("EndorseFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to         User @relation("EndorseTo", fields: [toId], references: [id], onDelete: Cascade)

  @@index([toId])
  @@index([kind])
}

model WeeklyCheckin {
  id          String   @id @default(cuid())
  userId      String
  cycleId     String
  weekStart   DateTime // Monday 00:00 UTC of that week
  whatWorked  String?
  whatBlocked String?
  nextFocus   String?
  managerReply String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycle PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
}

// Frozen quarterly snapshots — populated when a quarter ends so historical
// trends survive even if targets / weights change later.
model TrackSnapshot {
  id        String           @id @default(cuid())
  userId    String
  cycleId   String
  quarter   Int
  trackKind TrackKind
  actual    Float
  scorePct  Float
  weighted  Float
  createdAt DateTime         @default(now())

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycle PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([userId, cycleId, quarter, trackKind])
}

model TierAssignment {
  id         String           @id @default(cuid())
  userId     String
  cycleId    String
  quarter    Int
  tier       TierKind
  totalScore Float
  computedAt DateTime         @default(now())

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycle PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([userId, cycleId, quarter])
}

// -------------------- Live sessions (Teams) --------------------

// An admin-scheduled Teams meeting. On schedule we create a calendar event
// (which sends the Teams invite to attendees) and a folder named after
// `courseTitle` under the L&D SharePoint root. After the call, the cloud
// recording is copied into that folder and ingested as a Video (Phase 2),
// which can then auto-generate a quiz via the existing Gemini flow.
model LiveSession {
  id              String            @id @default(cuid())
  title           String
  description     String?
  // Folder name (== course/topic) created for the recording. Nested under
  // L&D/{folderParent} when set, else directly under the L&D root.
  courseTitle     String
  folderParent    String?
  scheduledById   String            // organizer (admin) — meeting is created as this user
  startAt         DateTime          // UTC instant
  endAt           DateTime          // UTC instant
  attendeeIds     Json              // string[] of User ids invited
  // Microsoft Graph references
  graphEventId    String?           // calendar event id on the organizer's calendar
  onlineMeetingId String?           // Teams onlineMeeting id (resolved for recording lookup)
  joinUrl         String?           @db.Text
  targetFolderId  String?           // driveItem id of the L&D/{courseTitle} folder
  // Recording ingestion (Phase 2)
  recordingItemId String?           // driveItem id of the copied recording
  recordedVideoId String?           // Video row created from the recording
  status          LiveSessionStatus @default(SCHEDULED)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  scheduledBy     User              @relation("LiveSessionOrganizer", fields: [scheduledById], references: [id])
  attendances     LiveAttendance[]

  @@index([startAt])
  @@index([status])
}

// Per-attendee attendance for a live session, pulled from the Teams attendance
// report after the meeting ends. Points are tiered on % of the session attended
// (>=75% full, >=40% half, else 0) and feed the KRA / weighted grade.
model LiveAttendance {
  id              String   @id @default(cuid())
  liveSessionId   String
  userId          String
  secondsAttended Int      @default(0)
  attendedPct     Float    @default(0)
  points          Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  liveSession     LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([liveSessionId, userId])
  @@index([userId])
}

enum LiveSessionStatus {
  SCHEDULED
  LIVE
  ENDED
  RECORDING_READY
  INGESTED
  CANCELLED
}

// ICAI Certification generator (§5). NO rendered file is stored — only the input
// payload + pinned template version/hash + client + creator + timestamp, so any past
// certificate is reproducible against the exact wording that made it.
model CertificateIssue {
  id              String   @id @default(cuid())
  formatId        String        // template id, e.g. "i-ufce"
  formatTitle     String        // denormalized for history display
  templateVersion String
  templateHash    String        // sha256 of locked text at issue time
  clientName      String        // the entity/client the certificate is issued for
  payload         Json          // field values — the regenerate-on-demand source
  acknowledged    Boolean  @default(false) // illustrative-format acknowledgment (§0.8)
  createdById     String
  createdBy       User     @relation("CertificateCreator", fields: [createdById], references: [id])
  createdAt       DateTime @default(now())

  @@index([createdById])
  @@index([formatId])
  @@index([createdAt])
}

// Firm-wide saved values for reusable certificate fields (firm name, FRN, signing
// member, designation, membership no., place). Powers the "pick / add / remove" dropdown
// on the Certification generator form so staff don't re-type the same signing details.
model CertificateFieldOption {
  id          String   @id @default(cuid())
  fieldKey    String        // e.g. "firmName", "placeOfSignature"
  value       String
  createdById String?       // who first added it (metadata only; list is shared firm-wide)
  createdAt   DateTime @default(now())

  @@unique([fieldKey, value])
  @@index([fieldKey])
}

// -------------------- SOP Builder (Tools) --------------------
// AI-assisted Standard Operating Procedures. Content is stored structured (Json) and
// rendered deterministically to the on-screen view and a Word (.docx) copy saved under
// OneDrive L&D/SOP/<Department>/. Viewable firm-wide; created/edited by admins + granted
// editors. Who-created is on each version; who-viewed-when is logged in SopView.
model Sop {
  id               String   @id @default(cuid())
  title            String
  department       Department
  workCategory     String
  currentVersionId String?
  createdById      String
  createdByName    String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  versions SopVersion[]
  views    SopView[]

  @@index([department])
  @@index([createdAt])
}

model SopVersion {
  id                 String   @id @default(cuid())
  sopId              String
  sop                Sop      @relation(fields: [sopId], references: [id], onDelete: Cascade)
  versionNumber      Int
  versionString      String
  purpose            String   @db.Text
  rawProcedure       String   @db.Text   // the user's layman input, preserved for editing
  brief              Json?                // the confirmed AI brief used to generate
  content            Json                 // the structured SOP (sections, tables, flowchart)
  graphItemId        String?              // OneDrive .docx item id for this version
  graphWebUrl        String?
  createdById        String
  creatorName        String
  creatorDesignation String
  createdAt          DateTime @default(now())

  @@index([sopId])
}

// Global create/edit grant. Admins are implicitly editors; this list adds employees.
model SopEditor {
  id          String   @id @default(cuid())
  userId      String   @unique
  userName    String
  userEmail   String
  grantedById String?
  createdAt   DateTime @default(now())
}

// Audit: who opened which SOP and when.
model SopView {
  id       String   @id @default(cuid())
  sopId    String
  sop      Sop      @relation(fields: [sopId], references: [id], onDelete: Cascade)
  userId   String
  userName String
  viewedAt DateTime @default(now())

  @@index([sopId])
  @@index([viewedAt])
}

// Audit trail for the Office Tools suite (document generators + tax PDF processors).
// No generated file is stored — this records who ran which tool, when, and a small
// summary (e.g. the client/firm name, or how many PDFs were processed). §no-storing.
model OfficeToolRun {
  id          String   @id @default(cuid())
  tool        String        // registry id, e.g. "mou", "gstr3b"
  toolTitle   String        // denormalized for history display
  category    String        // "Legal" | "Tax" | "Financial"
  summary     String        // human-readable one-liner (client name / file count)
  format      String        // "docx" | "xlsx"
  createdById String
  createdBy   User     @relation("OfficeToolRunner", fields: [createdById], references: [id])
  createdByName String
  createdAt   DateTime @default(now())

  @@index([createdById])
  @@index([tool])
  @@index([createdAt])
}

// Neo Centra (directors' cockpit) — compliance deadline completion tracking.
// Deadlines themselves are computed from FY rules (src/lib/neo-centra/compliance.ts);
// this table stores only whether each has been marked done, and by whom.
model NeoComplianceStatus {
  id              String    @id @default(cuid())
  fyStartYear     Int
  key             String    // "<type>:<period>", stable across regenerations
  status          String    @default("PENDING") // PENDING | DONE
  completedAt     DateTime?
  completedById   String?
  completedByName String?
  note            String?
  updatedAt       DateTime  @updatedAt

  @@unique([fyStartYear, key])
  @@index([fyStartYear])
}

// -------------------- Neo Centra · Incentives (Turia-fed) --------------------

// The firm's single Turia session cookie (captured from a logged-in Turia tab and
// relayed by a director). Used server-side to call Turia's internal API.
model NeoTuriaSession {
  id        Int      @id @default(1)
  cookie    String   @db.Text
  updatedById String?
  updatedByName String?
  updatedAt DateTime @updatedAt
}

// Per-director Turia mapping (director = a Partner user). Resolved by fuzzy
// name-match against Turia org users; turiaUsername is what timesheet rows match on.
model NeoDirectorMapping {
  userId        String   @id
  turiaUserId   String?
  turiaUsername String?
  updatedAt     DateTime @updatedAt
}

// Bucket 4 config: board-approved hour budgets for internal / company-dev tasks.
model NeoInternalBudget {
  id            String   @id @default(cuid())
  turiaTaskId   String?
  taskIdentity  String?  // Turia uniqueidentity, e.g. TSK03519
  taskName      String
  approvedHours Float
  approvedBy    String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([turiaTaskId])
  @@index([taskIdentity])
}

// Cached per-period incentive computations (Turia is slow/fragile; UI reads snapshots).
model NeoIncentiveSnapshot {
  id          String   @id @default(cuid())
  periodStart DateTime
  periodEnd   DateTime
  generatedAt DateTime @default(now())
  data        Json     // full per-director 4-bucket breakdown

  @@index([periodStart])
}
