// Indefine LMS — Prisma schema
// Designed for ~16 internal users on Railway Postgres.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------- Auth (NextAuth/Auth.js) --------------------

model User {
  id                  String        @id @default(cuid())
  name                String?
  email               String        @unique
  emailVerified       DateTime?
  image               String?
  role                Role          @default(EMPLOYEE)
  level               EmployeeLevel @default(EXECUTIVE)
  department          Department    @default(GENERAL)
  branchId            String?
  managerId           String?
  active              Boolean       @default(true)
  deactivatedAt       DateTime?
  // Shared / functional mailboxes (accounts@, info@, team inboxes) that sync in
  // from M365 but aren't real people — kept for invites/email, excluded from the
  // leaderboard, grading and the assignment picker.
  excludedFromScoring Boolean       @default(false)
  // Growth Wizard self-reflection — populated through the multi-step flow
  strengths           Json? // string[]
  aspiration          String? // free-text "where do you see yourself in 12mo"
  wizardSubmittedAt   DateTime?
  createdAt           DateTime      @default(now())

  accounts Account[]
  sessions Session[]

  progresses VideoProgress[]
  attempts   QuizAttempt[]

  assignments        Assignment[] @relation("AssignmentTarget")
  assignmentsCreated Assignment[] @relation("AssignmentCreator")

  manager User?   @relation("Reports", fields: [managerId], references: [id])
  reports User[]  @relation("Reports")
  branch  Branch? @relation(fields: [branchId], references: [id])

  // Trajectory
  quests              Quest[]
  questsApproved      Quest[]              @relation("QuestApprover")
  initiatives         Initiative[]
  initiativeReactions InitiativeReaction[]
  endorsementsGiven   Endorsement[]        @relation("EndorseFrom")
  endorsementsGot     Endorsement[]        @relation("EndorseTo")
  checkins            WeeklyCheckin[]
  trackSnapshots      TrackSnapshot[]
  tierAssignments     TierAssignment[]
  attendances         AttendanceRecord[]
  liveSessions        LiveSession[]        @relation("LiveSessionOrganizer")
  liveAttendances     LiveAttendance[]
  videosCreated       Video[]              @relation("VideoCreator")
  dailyActivity       DailyActivity[]
  certificateIssues   CertificateIssue[]   @relation("CertificateCreator")
  officeToolRuns      OfficeToolRun[]      @relation("OfficeToolRunner")
  opsClients          OpsClient[]          @relation("OpsClientCreator")
  opsSubscriptions    OpsSubscription[]    @relation("OpsSubscriptionCreator")
  opsReminders        OpsReminder[]        @relation("OpsReminderSender")
  clientsHandled      Client[]             @relation("ClientHandler")
  clientsCreated      Client[]             @relation("ClientCreator")
  jobsHandled         Job[]                @relation("JobHandler")
  jobsCreated         Job[]                @relation("JobCreator")
  clientDocsUploaded  ClientDocument[]     @relation("ClientDocUploader")
  worksOwned          Work[]               @relation("WorkOwner")
  worksCreated        Work[]               @relation("WorkCreator")
  workTasksAssigned   WorkTask[]           @relation("WorkTaskAssignee")
  workTasksCreated    WorkTask[]           @relation("WorkTaskCreator")
  weekPlanWorks       WeekPlanWork[]
  dayPicks            DayPick[]
  weekReviews         WeekReview[]
  workEvents          WorkEvent[]          @relation("WorkEventActor")
}

enum EmployeeLevel {
  // Legacy values kept so existing rows don't break — UI hides these.
  TRAINEE           @map("TRAINEE")
  ASSOCIATE         @map("ASSOCIATE")
  SENIOR            @map("SENIOR")
  LEAD              @map("LEAD")
  // CA-firm canonical levels
  ARTICLE
  EXECUTIVE
  SENIOR_EXECUTIVE
  ASSISTANT_MANAGER
  MANAGER
  SENIOR_MANAGER
  PARTNER
}

enum Department {
  AUDIT
  TAX
  ACCOUNTS
  ROC
  TECH // internal technology / engineering team
  ADMIN // operations / hr / finance / front office
  GENERAL // fallback / not-yet-assigned
}

enum Role {
  EMPLOYEE
  ADMIN
}

// Physical office location. Lets the firm scale across cities and
// compare branch performance side-by-side.
// One row per user per IST day they were active (logged in / opened the app).
// Feeds the learning streak so simply showing up counts — not only watching a
// video or taking a quiz. `day` is the IST calendar date "YYYY-MM-DD".
model DailyActivity {
  id     String @id @default(cuid())
  userId String
  day    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([userId])
}

model Branch {
  id        String   @id @default(cuid())
  name      String // "Bangalore HQ"
  code      String   @unique // short code "BLR" used in lists
  city      String?
  state     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users User[]
}

model Account {
  id                String    @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?   @db.Text
  access_token      String?   @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?   @db.Text
  session_state     String?
  // Set when this account granted the elevated Graph scopes (see src/lib/graph-scopes.ts).
  // The org sync clears stored tokens from non-admin accounts that never did.
  elevatedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -------------------- Learning content --------------------

model Course {
  id          String   @id @default(cuid())
  title       String
  description String?
  order       Int      @default(0)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules   Module[]
  deadlines Deadline[]
}

model Module {
  id          String  @id @default(cuid())
  courseId    String
  title       String
  description String?
  order       Int     @default(0)
  // Parent grouping folder under the L&D root (e.g. "Accounting" for
  // L&D/Accounting/Isha Misty KT). null for top-level folders. Lets the content
  // library mirror the SharePoint folder nesting.
  groupName   String?

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  videos      Video[]
  assignments Assignment[]
}

model Video {
  id              String   @id @default(cuid())
  moduleId        String
  title           String
  description     String?
  // Pasted script / notes (e.g. the NotebookLM source) used to ground AI quiz
  // generation. Saving this triggers an auto-generated 20-question quiz.
  sourceText      String?  @db.Text
  // Microsoft Graph identifiers — driveId + itemId let us re-fetch fresh stream URLs
  graphDriveId    String
  graphItemId     String
  durationSeconds Int?
  order           Int      @default(0)
  // Who added this content (credits the Initiative track). Set to the organizer
  // on a live-session recording; null for SharePoint-synced library videos.
  createdById     String?
  createdAt       DateTime @default(now())

  module      Module          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  createdBy   User?           @relation("VideoCreator", fields: [createdById], references: [id], onDelete: SetNull)
  quiz        Quiz?
  progresses  VideoProgress[]
  assignments Assignment[]
  materials   Material[]
}

// A downloadable handout attached to a video (PDF, worksheet, checklist...).
// The file itself lives in SharePoint next to the video; we only keep the Graph
// pointer, so nothing is duplicated into our DB.
model Material {
  id           String   @id @default(cuid())
  videoId      String
  name         String
  graphDriveId String
  graphItemId  String
  sizeBytes    Int?
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
}

model VideoProgress {
  id             String    @id @default(cuid())
  userId         String
  videoId        String
  watchedSeconds Int       @default(0)
  lastPosition   Int       @default(0)
  percent        Float     @default(0)
  completed      Boolean   @default(false)
  completedAt    DateTime?
  updatedAt      DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
}

// -------------------- Quizzes --------------------

model Quiz {
  id              String @id @default(cuid())
  videoId         String @unique
  title           String
  timeLimitSec    Int    @default(300) // whole-quiz timer
  passPercent     Int    @default(70)
  maxAttempts     Int? // null = unlimited
  unlockAtPercent Int    @default(90) // % of video that must be watched

  video     Video         @relation(fields: [videoId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  QuizAttempt[]
}

// App-wide settings (single row, id = 1). Holds the default quiz timing/pass
// applied to newly auto-generated quizzes.
model Settings {
  id                  Int      @id @default(1)
  quizTimeLimitSec    Int      @default(600) // 10 min
  quizPassPercent     Int      @default(70)
  quizUnlockAtPercent Int      @default(90)
  // Graph chat id of the "Tech Work" group chat used by the work-tracker nudges.
  workTeamsChatId     String?
  updatedAt           DateTime @updatedAt
}

model Question {
  id     String @id @default(cuid())
  quizId String
  text   String
  order  Int    @default(0)
  points Int    @default(1)

  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options Option[]
}

model Option {
  id         String  @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean @default(false)
  order      Int     @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id          String    @id @default(cuid())
  userId      String
  quizId      String
  score       Int       @default(0)
  maxScore    Int       @default(0)
  percent     Float     @default(0)
  passed      Boolean   @default(false)
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  // JSON of { questionId: optionId } answers
  answers     Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId, submittedAt])
}

// -------------------- Deadlines / KRA --------------------

model Deadline {
  id           String       @id @default(cuid())
  courseId     String
  kind         DeadlineKind @default(CUSTOM)
  dueAt        DateTime
  // points awarded toward KRA when completed on time
  pointsOnTime Int          @default(10)
  pointsLate   Int          @default(0)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

enum DeadlineKind {
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

// -------------------- Assignments --------------------

// Admin can assign two kinds of things to specific users:
//   VIDEO — links to a Video; auto-completes when the user watches it
//           (≥95%) AND passes its quiz (if one exists).
//   TASK  — free-text instruction. Admin marks complete manually.
// Each assignment carries its own KRA point value, which is awarded
// only when the assignment moves to COMPLETED.

model Assignment {
  id            String           @id @default(cuid())
  userId        String // who it's assigned to
  assignedById  String // admin who created it
  kind          AssignmentKind
  videoId       String? // populated for VIDEO kind
  moduleId      String? // populated for MODULE kind
  title         String // shown in lists; for TASK this is the instruction
  description   String?
  points        Int              @default(0)
  dueAt         DateTime?
  status        AssignmentStatus @default(PENDING)
  // Auto-created catch-up material (e.g. a live-session recording pushed to
  // attendees for visibility). Shows on the dashboard but is NOT a graded
  // obligation, so it's excluded from the Mastery/Delivery trajectory scores.
  autoGenerated Boolean          @default(false)
  completedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user       User    @relation("AssignmentTarget", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User    @relation("AssignmentCreator", fields: [assignedById], references: [id])
  video      Video?  @relation(fields: [videoId], references: [id], onDelete: SetNull)
  module     Module? @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([videoId])
  @@index([moduleId])
}

enum AssignmentKind {
  VIDEO
  MODULE
  TASK
}

enum AssignmentStatus {
  PENDING
  COMPLETED
}

// -------------------- Attendance (greytHR / Turia import) --------------------

// One row per employee per month, imported from the HR system's CSV export.
// Attendance % awards flat KRA points (same idea as Deadline points) that feed
// the leaderboard total in computeKraScores().
model AttendanceRecord {
  id            String   @id @default(cuid())
  userId        String
  periodMonth   DateTime // first day of the covered month, UTC midnight
  workingDays   Float // total working / payable days in the period
  presentDays   Float // days present (supports half-days)
  lateMarks     Int      @default(0)
  attendancePct Float // presentDays / workingDays * 100, stored for transparency
  points        Int // KRA points awarded for this month
  source        String   @default("greytHR")
  note          String?
  importedById  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodMonth])
  @@index([periodMonth])
}

// -------------------- Trajectory (performance OS) --------------------

// A "cycle" is a performance window (typically a financial year).
// Quarters Q1-Q4 are derived from the cycle's start date.
model PerformanceCycle {
  id        String   @id @default(cuid())
  name      String // "FY 2026-27"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  targets         TrackTarget[]
  quests          Quest[]
  initiatives     Initiative[]
  trackSnapshots  TrackSnapshot[]
  tierAssignments TierAssignment[]
  checkins        WeeklyCheckin[]
}

enum TrackKind {
  MASTERY // Auto: training compliance + best quiz scores
  DELIVERY // Auto: task/module completion, on-time finishes
  INITIATIVE // Self-log: initiatives kicked off, trainings led
  COLLABORATION // Self-log: cross-team help, mentorship
  VISION // Self-set: quarterly milestones on annual goals
  CRAFT // Manager-rated: quality + soft skills
}

// Per-cycle, per-level target + weight for each track.
// Score per track is normalized: actual / target * 100, capped at 100.
// Total score is the weighted sum of all six.
model TrackTarget {
  id        String        @id @default(cuid())
  cycleId   String
  trackKind TrackKind
  level     EmployeeLevel
  target    Float // raw value to score 100 (e.g. 12 modules)
  weight    Int // % contribution to total tier score (0-100)

  cycle PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([cycleId, trackKind, level])
}

enum TierKind {
  STELLAR // 90-100
  SOARING // 80-89
  SOLID // 70-79
  GROWING // 60-69
  FOCUSED // 50-59
  RECALIBRATING // < 50
}

enum QuestStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ACTIVE
  COMPLETED
  MISSED
}

model Quest {
  id           String      @id @default(cuid())
  userId       String
  cycleId      String
  title        String
  description  String?
  why          String? // why this matters to the employee
  weight       Int         @default(10) // contributes to VISION track
  status       QuestStatus @default(DRAFT)
  approvedById String?
  approvedAt   DateTime?
  completedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycle      PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  approvedBy User?            @relation("QuestApprover", fields: [approvedById], references: [id])
  milestones QuestMilestone[]

  @@index([userId, cycleId])
  @@index([status])
}

model QuestMilestone {
  id          String    @id @default(cuid())
  questId     String
  title       String
  quarter     Int // 1-4
  completed   Boolean   @default(false)
  completedAt DateTime?

  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)
}

enum InitiativeStatus {
  PITCHED
  FUNDED
  ACTIVE
  SHIPPED
  ARCHIVED
}

model Initiative {
  id          String           @id @default(cuid())
  userId      String
  cycleId     String
  title       String
  description String?
  impact      String? // expected impact statement
  status      InitiativeStatus @default(PITCHED)
  fundedById  String?
  fundedAt    DateTime?
  shippedAt   DateTime?
  upvotes     Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycle     PerformanceCycle     @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  reactions InitiativeReaction[]

  @@index([cycleId, status])
}

enum ReactionKind {
  UPVOTE // 🚀 generic support
  INTERESTED // 🙋 count me in
}

model InitiativeReaction {
  id           String       @id @default(cuid())
  initiativeId String
  userId       String
  kind         ReactionKind @default(UPVOTE)
  createdAt    DateTime     @default(now())

  initiative Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([initiativeId, userId, kind])
  @@index([initiativeId])
}

enum EndorsementKind {
  COLLABORATION // counts toward Collaboration track
  INITIATIVE // counts toward Initiative track
  MENTORSHIP // counts toward Collaboration track
  CROSS_DEPT // counts toward Collaboration track
  CRAFT // manager rating for Craft track (uses score 1-5)
}

model Endorsement {
  id           String          @id @default(cuid())
  fromId       String
  toId         String
  kind         EndorsementKind
  score        Int? // 1-5 for CRAFT; null for count-based endorsements
  reason       String?
  approvedById String? // for ones that need manager endorsement
  approvedAt   DateTime?
  createdAt    DateTime        @default(now())

  from User @relation("EndorseFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("EndorseTo", fields: [toId], references: [id], onDelete: Cascade)

  @@index([toId])
  @@index([kind])
}

model WeeklyCheckin {
  id           String   @id @default(cuid())
  userId       String
  cycleId      String
  weekStart    DateTime // Monday 00:00 UTC of that week
  whatWorked   String?
  whatBlocked  String?
  nextFocus    String?
  managerReply String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycle PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
}

// Frozen quarterly snapshots — populated when a quarter ends so historical
// trends survive even if targets / weights change later.
model TrackSnapshot {
  id        String    @id @default(cuid())
  userId    String
  cycleId   String
  quarter   Int
  trackKind TrackKind
  actual    Float
  scorePct  Float
  weighted  Float
  createdAt DateTime  @default(now())

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycle PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([userId, cycleId, quarter, trackKind])
}

model TierAssignment {
  id         String   @id @default(cuid())
  userId     String
  cycleId    String
  quarter    Int
  tier       TierKind
  totalScore Float
  computedAt DateTime @default(now())

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycle PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([userId, cycleId, quarter])
}

// -------------------- Live sessions (Teams) --------------------

// An admin-scheduled Teams meeting. On schedule we create a calendar event
// (which sends the Teams invite to attendees) and a folder named after
// `courseTitle` under the L&D SharePoint root. After the call, the cloud
// recording is copied into that folder and ingested as a Video (Phase 2),
// which can then auto-generate a quiz via the existing Gemini flow.
model LiveSession {
  id              String            @id @default(cuid())
  title           String
  description     String?
  // Folder name (== course/topic) created for the recording. Nested under
  // L&D/{folderParent} when set, else directly under the L&D root.
  courseTitle     String
  folderParent    String?
  scheduledById   String // organizer (admin) — meeting is created as this user
  startAt         DateTime // UTC instant
  endAt           DateTime // UTC instant
  attendeeIds     Json // string[] of User ids invited
  // Microsoft Graph references
  graphEventId    String? // calendar event id on the organizer's calendar
  onlineMeetingId String? // Teams onlineMeeting id (resolved for recording lookup)
  joinUrl         String?           @db.Text
  targetFolderId  String? // driveItem id of the L&D/{courseTitle} folder
  // Recording ingestion (Phase 2)
  recordingItemId String? // driveItem id of the copied recording
  recordedVideoId String? // Video row created from the recording
  status          LiveSessionStatus @default(SCHEDULED)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  scheduledBy User             @relation("LiveSessionOrganizer", fields: [scheduledById], references: [id])
  attendances LiveAttendance[]

  @@index([startAt])
  @@index([status])
}

// Per-attendee attendance for a live session, pulled from the Teams attendance
// report after the meeting ends. Points are tiered on % of the session attended
// (>=75% full, >=40% half, else 0) and feed the KRA / weighted grade.
model LiveAttendance {
  id              String   @id @default(cuid())
  liveSessionId   String
  userId          String
  secondsAttended Int      @default(0)
  attendedPct     Float    @default(0)
  points          Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  liveSession LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([liveSessionId, userId])
  @@index([userId])
}

enum LiveSessionStatus {
  SCHEDULED
  LIVE
  ENDED
  RECORDING_READY
  INGESTED
  CANCELLED
}

// ICAI Certification generator (§5). NO rendered file is stored — only the input
// payload + pinned template version/hash + client + creator + timestamp, so any past
// certificate is reproducible against the exact wording that made it.
model CertificateIssue {
  id              String   @id @default(cuid())
  formatId        String // template id, e.g. "i-ufce"
  formatTitle     String // denormalized for history display
  templateVersion String
  templateHash    String // sha256 of locked text at issue time
  clientName      String // the entity/client the certificate is issued for
  clientId        String? // LMS Client.id when issued from a client record (DPDP: join by id, not typed name)
  payload         Json // field values — the regenerate-on-demand source
  acknowledged    Boolean  @default(false) // illustrative-format acknowledgment (§0.8)
  createdById     String
  createdBy       User     @relation("CertificateCreator", fields: [createdById], references: [id])
  createdAt       DateTime @default(now())

  @@index([createdById])
  @@index([formatId])
  @@index([createdAt])
  @@index([clientId])
}

// Firm-wide saved values for reusable certificate fields (firm name, FRN, signing
// member, designation, membership no., place). Powers the "pick / add / remove" dropdown
// on the Certification generator form so staff don't re-type the same signing details.
model CertificateFieldOption {
  id          String   @id @default(cuid())
  fieldKey    String // e.g. "firmName", "placeOfSignature"
  value       String
  createdById String? // who first added it (metadata only; list is shared firm-wide)
  createdAt   DateTime @default(now())

  @@unique([fieldKey, value])
  @@index([fieldKey])
}

// -------------------- SOP Builder (Tools) --------------------
// AI-assisted Standard Operating Procedures. Content is stored structured (Json) and
// rendered deterministically to the on-screen view and a Word (.docx) copy saved under
// OneDrive L&D/SOP/<Department>/. Viewable firm-wide; created/edited by admins + granted
// editors. Who-created is on each version; who-viewed-when is logged in SopView.
model Sop {
  id               String     @id @default(cuid())
  title            String
  department       Department
  workCategory     String
  currentVersionId String?
  createdById      String
  createdByName    String
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  // OneDrive folder holding every version's Word file. Named after the title once, when the SOP
  // is first saved, and found by id after that, so a rename or a same-title SOP never splits or
  // overwrites it.
  graphFolderId    String?

  versions SopVersion[]
  views    SopView[]
  images   SopImage[]

  @@index([department])
  @@index([createdAt])
}

model SopVersion {
  id                 String   @id @default(cuid())
  sopId              String
  sop                Sop      @relation(fields: [sopId], references: [id], onDelete: Cascade)
  versionNumber      Int
  versionString      String
  purpose            String   @db.Text
  rawProcedure       String   @db.Text // the user's layman input, preserved for editing
  brief              Json? // the confirmed AI brief used to generate
  content            Json // the structured SOP (sections, tables, flowchart)
  graphItemId        String? // OneDrive .docx item id for this version
  graphWebUrl        String?
  createdById        String
  creatorName        String
  creatorDesignation String
  createdAt          DateTime @default(now())

  @@index([sopId])
}

// A screenshot shown under a step (SopDetailStep.screens). Marked up in the browser before it is
// sent, so a hidden area is already black here; the unmarked original never leaves the browser.
// Never sent to the AI. Versions point at images by id, so a new version does not copy them.
model SopImage {
  id          String   @id @default(cuid())
  sopId       String
  sop         Sop      @relation(fields: [sopId], references: [id], onDelete: Cascade)
  mime        String // image/png | image/jpeg
  bytes       Bytes
  width       Int
  height      Int
  createdById String
  createdAt   DateTime @default(now())

  @@index([sopId])
}

// Global create/edit grant. Admins are implicitly editors; this list adds employees.
model SopEditor {
  id          String   @id @default(cuid())
  userId      String   @unique
  userName    String
  userEmail   String
  grantedById String?
  createdAt   DateTime @default(now())
}

// Audit: who opened which SOP and when.
model SopView {
  id       String   @id @default(cuid())
  sopId    String
  sop      Sop      @relation(fields: [sopId], references: [id], onDelete: Cascade)
  userId   String
  userName String
  viewedAt DateTime @default(now())

  @@index([sopId])
  @@index([viewedAt])
}

// Audit trail for the Office Tools suite (document generators + tax PDF processors).
// No generated file is stored — this records who ran which tool, when, and a small
// summary (e.g. the client/firm name, or how many PDFs were processed). §no-storing.
model OfficeToolRun {
  id            String   @id @default(cuid())
  tool          String // registry id, e.g. "mou", "gstr3b"
  toolTitle     String // denormalized for history display
  category      String // "Legal" | "Tax" | "Financial"
  summary       String // human-readable one-liner (client name / file count)
  format        String // "docx" | "xlsx"
  createdById   String
  createdBy     User     @relation("OfficeToolRunner", fields: [createdById], references: [id])
  createdByName String
  createdAt     DateTime @default(now())

  @@index([createdById])
  @@index([tool])
  @@index([createdAt])
}

// -------------------- Neo Centra · Incentives (Turia-fed) --------------------

// The firm's single Turia session cookie (captured from a logged-in Turia tab and
// relayed by a director). Used server-side to call Turia's internal API.
model NeoTuriaSession {
  id            Int      @id @default(1)
  cookie        String   @db.Text
  updatedById   String?
  updatedByName String?
  updatedAt     DateTime @updatedAt
}

// Per-director Turia mapping (director = a Partner user). Resolved by fuzzy
// name-match against Turia org users; turiaUsername is what timesheet rows match on.
model NeoDirectorMapping {
  userId        String   @id
  turiaUserId   String?
  turiaUsername String?
  updatedAt     DateTime @updatedAt
}

// Bucket 4 config: board-approved hour budgets for internal / company-dev tasks.
model NeoInternalBudget {
  id            String   @id @default(cuid())
  turiaTaskId   String?
  taskIdentity  String? // Turia uniqueidentity, e.g. TSK03519
  taskName      String
  approvedHours Float
  approvedBy    String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([turiaTaskId])
  @@index([taskIdentity])
}

// Bucket 3 manual profit splits — for a task worked by 2+ partners, admins set how
// its profit divides between them (e.g. 40/60). No row → equal split (the default).
model NeoProfitSplit {
  id           String   @id @default(cuid())
  turiaTaskId  String?
  taskIdentity String? // Turia uniqueidentity, e.g. TSK03732
  taskName     String
  splits       Json // { [directorId]: percent } — must sum to 100
  updatedBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([turiaTaskId])
  @@index([taskIdentity])
}

// Bucket 4 planned-hours allocation — how a shared internal task's effort is meant to
// split between partners (e.g. Lakshmanan 30h, Abijith 69h). Entered freely by admins;
// not required to reconcile to Turia's Budget Time. No row → that partner has no target.
model NeoHoursSplit {
  id           String   @id @default(cuid())
  turiaTaskId  String?
  taskIdentity String? // Turia uniqueidentity, e.g. TSK03625
  taskName     String
  hours        Json // { [directorId]: plannedHours }
  updatedBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([turiaTaskId])
  @@index([taskIdentity])
}

// Cached per-period incentive computations (Turia is slow/fragile; UI reads snapshots).
model NeoIncentiveSnapshot {
  id          String   @id @default(cuid())
  periodStart DateTime
  periodEnd   DateTime
  generatedAt DateTime @default(now())
  data        Json // full per-director 4-bucket breakdown

  @@index([periodStart])
}

// -------------------- Client onboarding --------------------
// Client master + per-FY jobs + documents filed to SharePoint under
// <GRAPH_CLIENTS_ROOT>/<Client.folderName>/... Postgres is the source of truth;
// the Excel workbook on SharePoint is regenerated from these tables.

enum EntityType {
  INDIVIDUAL
  HUF
  PROPRIETORSHIP
  PARTNERSHIP
  LLP
  PVT_LTD
  PUBLIC_LTD
  TRUST_SOCIETY
  OTHER
}

enum TurnoverBand {
  UNDER_40L
  L40_TO_1CR
  CR1_TO_5CR
  CR5_TO_20CR
  ABOVE_20CR
}

enum GrowthGoal {
  EXPAND_LOCATIONS
  RAISE_FUNDING
  CONVERT_ENTITY
  EXPORT
  COMPLIANCE_CLEANUP
  COST_REDUCTION
  EXIT_SALE
  MAINTAIN
  OTHER
}

enum FolderStatus {
  PENDING
  READY
  FAILED
}

enum JobStatus {
  NOT_STARTED
  IN_PROGRESS
  DELIVERED
  CLOSED
}

enum ClientDocType {
  // client-level (KYC)
  PAN
  AADHAAR_DIN
  INCORPORATION_DEED
  GST_CERT
  MOA_AOA
  BANK
  ENGAGEMENT_LETTER
  OTHER_KYC
  // job-level
  SOURCE_DATA
  WORKING_PAPERS
  FILED_RETURN
  ACKNOWLEDGEMENT
  SIGN_OFF
  OTHER_JOB
}

model Client {
  id               String       @id @default(cuid())
  name             String       @unique
  folderName       String       @unique
  entityType       EntityType
  pan              String?      @unique
  gstin            String?
  cin              String?
  industry         String?
  city             String?
  contactName      String?
  contactPhone     String?
  contactEmail     String?
  referralSource   String?
  turnover         Float // rupees
  turnoverBand     TurnoverBand
  growthGoal       GrowthGoal
  growthNote       String?
  onboardedOn      DateTime
  primaryHandlerId String
  active           Boolean      @default(true)
  graphFolderId    String?
  folderStatus     FolderStatus @default(PENDING)
  createdById      String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  primaryHandler User             @relation("ClientHandler", fields: [primaryHandlerId], references: [id])
  createdBy      User             @relation("ClientCreator", fields: [createdById], references: [id])
  jobs           Job[]
  documents      ClientDocument[]
  firmClient     FirmClient?

  @@index([primaryHandlerId])
  @@index([turnoverBand])
}

// Admin-editable service list, one row per (department, service).
model ServiceType {
  id         String     @id @default(cuid())
  department Department
  name       String
  active     Boolean    @default(true)
  order      Int        @default(0)

  jobs Job[]

  @@unique([department, name])
}

model Job {
  id            String       @id @default(cuid())
  clientId      String
  serviceTypeId String
  fy            String // "2026-27"
  handlerId     String
  status        JobStatus    @default(NOT_STARTED)
  dueOn         DateTime?
  fees          Float? // rupees
  notes         String?
  graphFolderId String?
  folderStatus  FolderStatus @default(PENDING)
  createdById   String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  client      Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceType ServiceType      @relation(fields: [serviceTypeId], references: [id])
  handler     User             @relation("JobHandler", fields: [handlerId], references: [id])
  createdBy   User             @relation("JobCreator", fields: [createdById], references: [id])
  documents   ClientDocument[]

  @@unique([clientId, serviceTypeId, fy])
  @@index([handlerId])
  @@index([fy])
  @@index([status])
}

// jobId null = client-level KYC document. Same shape as Material.
model ClientDocument {
  id           String        @id @default(cuid())
  clientId     String
  jobId        String?
  docType      ClientDocType
  name         String
  graphDriveId String
  graphItemId  String
  webUrl       String
  sizeBytes    Int?
  uploadedById String
  createdAt    DateTime      @default(now())

  client     Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  job        Job?   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation("ClientDocUploader", fields: [uploadedById], references: [id])

  @@index([clientId])
  @@index([jobId])
}

// -------------------- Tech work tracker (/work) --------------------
// Two-person focus tool. Work -> Task. Rules in src/lib/work/core.ts, every
// write in src/lib/work/db.ts appends a WorkEvent in the same transaction.

enum WorkStatus {
  INBOX // "Ideas"
  ACTIVE // "Working"
  PARKED // "Paused"
  DONE
  OBSOLETE
}

enum WorkTaskStatus {
  TODO
  DONE
  DROPPED
}

enum DayPickOutcome {
  DONE
  CARRIED
}

enum WorkEventKind {
  WORK_CREATED
  WORK_STATUS
  WORK_REOPENED
  TASK_CREATED
  TASK_DONE
  TASK_DROPPED
  TASK_REVIEWED
  TASK_REOPENED
  PICKED
  CARRIED
  AUTO_PAUSED
  WEEK_PLANNED
  WEEK_REVIEWED
}

model Work {
  id             String     @id @default(cuid())
  title          String
  why            String? // one line: what changes when this is done
  ownerId        String
  status         WorkStatus @default(INBOX)
  obsoleteReason String?
  lastTouchedAt  DateTime   @default(now())
  doneAt         DateTime?
  createdById    String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  owner     User           @relation("WorkOwner", fields: [ownerId], references: [id])
  createdBy User           @relation("WorkCreator", fields: [createdById], references: [id])
  tasks     WorkTask[]
  events    WorkEvent[]
  weekPlans WeekPlanWork[]

  @@index([ownerId, status])
  @@index([status, lastTouchedAt])
}

model WorkTask {
  id          String         @id @default(cuid())
  workId      String
  title       String
  assigneeId  String
  status      WorkTaskStatus @default(TODO)
  order       Int            @default(0)
  doneAt      DateTime?
  reviewedAt  DateTime? // lead's tick on a task someone else finished; set at once for the lead's own
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  work      Work      @relation(fields: [workId], references: [id], onDelete: Cascade)
  assignee  User      @relation("WorkTaskAssignee", fields: [assigneeId], references: [id])
  createdBy User      @relation("WorkTaskCreator", fields: [createdById], references: [id])
  picks     DayPick[]

  @@index([workId, status])
  @@index([assigneeId, status])
}

// One row per (person, week, work): "this work is in my plan this week".
model WeekPlanWork {
  id        String   @id @default(cuid())
  userId    String
  weekStart DateTime // Monday 00:00 IST, stored as the UTC instant
  workId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart, workId])
}

// One row per (person, day, task) the person promised to do that day.
model DayPick {
  id      String          @id @default(cuid())
  userId  String
  day     DateTime // IST calendar day, 00:00 IST as the UTC instant
  taskId  String
  outcome DayPickOutcome? // null while the day is open

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task WorkTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, day, taskId])
  @@index([userId, day])
}

// Exists once the person has finished the Friday review for that week.
model WeekReview {
  id        String   @id @default(cuid())
  userId    String
  weekStart DateTime
  doneAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
}

// Append-only timeline. Every server action and cron sweep writes one row.
model WorkEvent {
  id     String        @id @default(cuid())
  workId String
  taskId String?
  userId String? // null when written by cron
  kind   WorkEventKind
  detail String? // one plain line, e.g. the task title or "Ideas → Working"
  at     DateTime      @default(now())

  work Work  @relation(fields: [workId], references: [id], onDelete: Cascade)
  user User? @relation("WorkEventActor", fields: [userId], references: [id])

  @@index([workId, at])
}

// -------------------- Client ops: hosting & domain renewals --------------------
// Deliberately separate from `Client` above: those are the firm's CA clients (audit, tax,
// ROC). These are the web/hosting accounts the studio runs — a different list of people,
// different billing. Keeping them apart means neither tool can corrupt the other's data.

enum SubscriptionKind {
  DOMAIN
  HOSTING
  VERCEL
  RAILWAY
  EMAIL
  OTHER
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

/// A web/hosting client. No credentials are ever stored here — see docs/client-ops.md.
model OpsClient {
  id      String  @id @default(cuid())
  name    String  @unique
  email   String
  contact String?
  active  Boolean @default(true)
  notes   String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy     User              @relation("OpsClientCreator", fields: [createdById], references: [id])
  subscriptions OpsSubscription[]

  @@index([active])
}

/// One renewable service: a domain, a hosting plan, a PaaS project. `expiresOn` is the
/// billing deadline. `sslExpiresOn` is the certificate, which rides its own ~90-day cycle
/// and is never written into the billing date.
model OpsSubscription {
  id           String           @id @default(cuid())
  clientId     String
  kind         SubscriptionKind
  provider     String
  expiresOn    DateTime
  cycle        BillingCycle     @default(YEARLY)
  costPaid     Float? // rupees we pay the provider
  chargeAmount Float // rupees we bill the client
  renewalLink  String?
  active       Boolean          @default(true)
  notes        String?

  // Credential-free auto-checks. `domain` is looked up in the registry (RDAP);
  // `sslHost` is TLS-probed. Neither needs a provider account.
  domain       String?
  sslHost      String?
  sslExpiresOn DateTime?
  checkedAt    DateTime?
  checkNote    String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client    OpsClient     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User          @relation("OpsSubscriptionCreator", fields: [createdById], references: [id])
  reminders OpsReminder[]

  @@index([clientId])
  @@index([expiresOn])
  @@index([active, expiresOn])
}

/// A renewal reminder the team sent (or marked as sent) — an audit trail in the same
/// spirit as OfficeToolRun: who asked which client for what, and when.
model OpsReminder {
  id             String   @id @default(cuid())
  subscriptionId String
  sentById       String
  sentAt         DateTime @default(now())
  subject        String
  body           String

  subscription OpsSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  sentBy       User            @relation("OpsReminderSender", fields: [sentById], references: [id])

  @@index([subscriptionId])
  @@index([sentAt])
}

// -------------------- Engagement letters (Office Tools) --------------------
// One row per client per FY. `data` is the generator form (reloaded to edit and
// regenerate). The PDFs live in SharePoint under Engagement Letters/<client>/ with a
// fixed name per FY, so a re-upload replaces the file and SharePoint keeps the
// version history. Every save/upload/send is appended to EngagementLetterEvent.
// Flow: draft PDF (unsigned) → emailed for approval → client approves → Indefine signs
// → signed PDF emailed → client countersigns. Saving an edit restarts at DRAFT.
enum EngagementLetterStatus {
  DRAFT // form saved; no draft PDF for this version yet
  DRAFT_UPLOADED // unsigned draft PDF uploaded
  SENT_FOR_APPROVAL // draft emailed to the client
  APPROVED // client approved the draft (recorded by staff)
  SIGNED // Indefine-signed PDF uploaded
  SENT // signed letter emailed to the client
  CLIENT_SIGNED // client's countersigned copy uploaded
}

model EngagementLetter {
  id                 String                  @id @default(cuid())
  clientName         String // as in Turia; also the SharePoint folder name
  clientId           String? // LMS Client.id when linked (DPDP: join by id, not typed name)
  fy                 String // "26-27"
  data               Json
  status             EngagementLetterStatus  @default(DRAFT)
  graphDriveId       String?
  draftItemId        String?
  draftWebUrl        String?
  draftSentAt        DateTime?
  approvedAt         DateTime?
  signedItemId       String?
  signedWebUrl       String?
  clientSignedItemId String?
  clientSignedWebUrl String?
  sentAt             DateTime?
  sentTo             String?
  createdById        String
  createdByName      String
  updatedByName      String
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  events             EngagementLetterEvent[]

  @@unique([clientName, fy])
  @@index([updatedAt])
  @@index([clientId])
}

model EngagementLetterEvent {
  id       String           @id @default(cuid())
  letterId String
  letter   EngagementLetter @relation(fields: [letterId], references: [id], onDelete: Cascade)
  action   String // "saved" | "signed-upload" | "sent" | "client-signed-upload"
  detail   String?
  data     Json? // form snapshot for "saved", so any earlier version can be restored
  byId     String
  byName   String
  at       DateTime         @default(now())

  @@index([letterId, at])
}

// Statutory updates digest (Tools). One row per post collected from an Indian statutory
// portal. Six portals are collected on the server; six that refuse non-Indian IPs are
// collected by the statutory-extension on an office PC and pushed in. Dates are IST
// calendar days as "YYYY-MM-DD"; postedOn (upload date, else document date) drives ranges.
model StatutoryPost {
  id           String    @id @default(cuid())
  key          String    @unique // portal | url | first 60 chars of title
  portal       String
  section      String?
  docType      String
  title        String
  issueDate    String?
  uploadDate   String?
  postedOn     String
  dateBasis    String // "upload" | "issue" | "file-server" | "text"
  url          String
  altUrl       String?
  text         String?   @db.Text // start of the document, input to the summary
  area         String?
  tag          String? // "Action" | "Info" | "Internal"
  summary      String?   @db.Text
  note         String?
  summarizedAt DateTime?
  summaryError String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([postedOn])
  @@index([summarizedAt])
}

// Latest collection result per portal (status line at the top of each tab).
model StatutorySource {
  portal    String   @id
  status    String // "ok" | "no posts" | "partial" | "failed"
  note      String
  fetched   Int
  inRange   Int
  via       String // "server" | "extension"
  checkedAt DateTime
}

// -------------------- Firm OS: shared spine --------------------
// Indefine Firm OS (docs/adr/). Additive only: nothing here alters an LMS column.
// FirmClient ties an LMS Client to its firm/Turia client code and CL-{Code} SharePoint site.
// ModelCall logs every ModelRouter call (src/lib/ai/router.ts) — prompt hash only, never raw
// prompts. AuditEvent records every create/approve/close/export/escalation (Phase 11).

model FirmClient {
  id                String   @id @default(cuid())
  lmsClientId       String   @unique
  clientCode        String   @unique // uppercase A–Z0–9, 3–10 chars (docs/folder-contract.md)
  turiaClientRef    String?
  clSiteUrl         String?
  preferredLanguage String   @default("en") // en | kn | ta | hi — comms drafts (Phase 10)
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  client      Client       @relation(fields: [lmsClientId], references: [id])
  engagements Engagement[]
  jobTasks    JobTask[]
}

enum ModelProviderId {
  claude
  grok
  local
}

enum ModelTier {
  FAST
  SMART
  HARD
  LOCAL
}

enum ModelCallStatus {
  OK
  SCHEMA_FAIL
  LOW_CONFIDENCE
  PROVIDER_ERROR
  QUEUED_FOR_HUMAN
  BUDGET_REFUSED
}

model ModelCall {
  id              String           @id @default(cuid())
  runId           String
  agent           String? // gst | roc | tax | books | audit | onboarding | comms | coach
  task            String
  provider        ModelProviderId?
  model           String?
  tier            ModelTier?
  privacy         String // local-only | anonymize-then-cloud | public
  difficulty      String // sop | judgement | novel
  escalated       Boolean          @default(false)
  escalationLevel Int              @default(0)
  anonymized      Boolean          @default(false)
  status          ModelCallStatus
  confidence      Float?
  tokensIn        Int              @default(0)
  tokensOut       Int              @default(0)
  costInr         Decimal          @default(0) @db.Decimal(12, 4)
  latencyMs       Int              @default(0)
  promptHash      String // sha256 of the masked prompt
  error           String?
  createdAt       DateTime         @default(now())

  @@index([runId])
  @@index([createdAt])
  @@index([agent, createdAt])
}

model AuditEvent {
  id        String   @id @default(cuid())
  actorId   String?
  action    String // create | approve | close | export | escalate | ...
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@index([action, createdAt])
}

// -------------------- Firm OS: jobs, agents, close loop --------------------
// JobTask is the Firm OS job state machine (ADR-005). DONE is reachable only through
// closeLoop.gate() (src/lib/close-loop/gate.ts); every transition appends a JobTaskEvent.
// Service names match the SharePoint folder contract (docs/folder-contract.md).

enum FirmService {
  GST
  ROC
  IncomeTax
  TDS
  Books
  Audit
  Engagement
}

enum JobTaskState {
  DRAFT
  ASSIGNED
  IN_PREP
  AGENT_DONE
  IN_REVIEW
  APPROVED
  FILED_BY_HUMAN
  CLOSING
  DONE
}

model Engagement {
  id           String      @id @default(cuid())
  firmClientId String
  service      FirmService
  frequency    String // MONTHLY | QUARTERLY | ANNUAL
  assigneeId   String?
  reviewerId   String?
  firstPeriod  String?
  sopPackKey   String?
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  firmClient FirmClient @relation(fields: [firmClientId], references: [id])
  jobTasks   JobTask[]

  @@unique([firmClientId, service])
}

// Versioned SOP pack: statutory calendar + checklist rules as data. A promoted MistakeLog
// rule creates a new minor version; nothing is edited in place.
model SopPack {
  id           String   @id @default(cuid())
  key          String // gst | roc | tax | books | audit | onboarding
  version      String // semver "1.3.0"
  major        Int
  minor        Int
  patch        Int      @default(0)
  title        String
  calendar     Json? // statutory due-date rules (src/lib/agents/core/calendar.ts)
  checklist    Json? // rule definitions (src/lib/agents/core/checklist.ts)
  bufferDays   Int      @default(3)
  active       Boolean  @default(true)
  createdById  String?
  approvedById String?
  changeNote   String?
  createdAt    DateTime @default(now())

  @@unique([key, version])
  @@index([key, active])
}

model JobTask {
  id                 String       @id @default(cuid())
  firmClientId       String
  engagementId       String?
  lmsJobId           String? // link to the legacy /clients Job, when one exists
  service            FirmService
  fy                 String // "2026-27"
  period             String // "2026-10" | "Q2" | "Annual"
  title              String // e.g. "GSTR-3B"
  state              JobTaskState @default(DRAFT)
  assigneeId         String?
  reviewerId         String?
  statutoryDueOn     DateTime?
  internalDueOn      DateTime?
  sopPackVersion     String?
  needsPartnerReview Boolean      @default(false)
  ackRef             String? // GST ARN / MCA SRN / ITR ack - stored, never verified against a portal
  filedById          String?
  filedAt            DateTime?
  doneAt             DateTime?
  createdById        String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  firmClient   FirmClient     @relation(fields: [firmClientId], references: [id])
  engagement   Engagement?    @relation(fields: [engagementId], references: [id])
  events       JobTaskEvent[]
  agentRuns    AgentRun[]
  deliverables Deliverable[]
  turiaSyncs   TuriaSync[]

  @@unique([firmClientId, service, fy, period, title])
  @@index([assigneeId, state])
  @@index([state])
  @@index([internalDueOn])
  @@index([reviewerId, state])
  @@index([state, doneAt])
}

// Append-only state history: cycle time (assigned to done, prep, review, wait-on-client).
model JobTaskEvent {
  id        String        @id @default(cuid())
  jobTaskId String
  fromState JobTaskState?
  toState   JobTaskState
  actorId   String?
  note      String?
  createdAt DateTime      @default(now())

  jobTask JobTask @relation(fields: [jobTaskId], references: [id])

  @@index([jobTaskId, createdAt])
}

model AgentRun {
  id                 String    @id @default(cuid())
  jobTaskId          String
  agent              String // gst | roc | tax | books | audit | echo
  sopPackVersion     String
  status             String // RUNNING | AGENT_DONE | FAILED | CHANGES_REQUESTED | APPROVED
  attempt            Int       @default(1)
  reviewNotes        String?
  inputs             Json? // cached inputs; purge after inputsPurgeAt (ADR-006, max 30 days)
  inputsPurgeAt      DateTime?
  figures            Json? // deterministic computed figures
  needsPartnerReview Boolean   @default(false)
  error              String?
  startedById        String?
  startedAt          DateTime  @default(now())
  finishedAt         DateTime?

  jobTask      JobTask           @relation(fields: [jobTaskId], references: [id])
  checklist    ChecklistResult[]
  deliverables Deliverable[]

  @@index([jobTaskId, startedAt])
  @@index([agent, startedAt])
  @@index([startedAt])
  @@index([inputsPurgeAt])
}

model ChecklistResult {
  id         String   @id @default(cuid())
  agentRunId String
  ruleId     String
  severity   String // block | warn | info
  status     String // pass | fail | na
  message    String
  evidence   Json? // { quote, location, link }
  source     String // deterministic | llm | mistake
  createdAt  DateTime @default(now())

  agentRun AgentRun @relation(fields: [agentRunId], references: [id])

  @@index([agentRunId])
  @@index([agentRunId, status])
}

enum MistakeStatus {
  PROPOSED
  APPROVED
  REJECTED
}

// Supervised learning loop: a reviewer logs a missed/wrong finding; a partner or manager
// approves it into a versioned checklist rule. Nothing auto-promotes.
model MistakeLog {
  id                String        @id @default(cuid())
  agent             String
  pattern           String
  ruleProposal      Json
  example           Json?
  agentRunId        String?
  status            MistakeStatus @default(PROPOSED)
  createdById       String
  decidedById       String?
  decidedAt         DateTime?
  promotedToVersion String?
  createdAt         DateTime      @default(now())

  @@index([agent, status])
}

model Deliverable {
  id           String    @id @default(cuid())
  jobTaskId    String
  agentRunId   String?
  kind         String // Working | Final
  name         String
  spPath       String // must equal deliverablePath() for Final
  driveId      String?
  driveItemId  String?
  sha256       String
  quickXorHash String? // SharePoint content hash recorded at upload (verify without download)
  cTag         String? // SharePoint content tag at upload; any edit changes it
  sizeBytes    Int
  version      Int       @default(1)
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())

  jobTask  JobTask   @relation(fields: [jobTaskId], references: [id])
  agentRun AgentRun? @relation(fields: [agentRunId], references: [id])

  @@index([jobTaskId, kind])
}

enum TuriaSyncStatus {
  PENDING
  CHECKLIST_ISSUED
  CONFIRMED
  CLOSED
  FAILED
}

model TuriaSync {
  id              String          @id @default(cuid())
  jobTaskId       String?
  firmClientId    String?
  operation       String // createClient | addService | createTask | closeTask
  mode            String // API | MANUAL | UI
  status          TuriaSyncStatus @default(PENDING)
  turiaRef        String?
  minutesLogged   Int?
  evidence        Json?
  confirmedById   String?
  spotChecked     Boolean         @default(false)
  spotCheckedById String?
  spotCheckedAt   DateTime?
  spotCheckNote   String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  jobTask JobTask? @relation(fields: [jobTaskId], references: [id])

  @@index([jobTaskId])
  @@index([firmClientId])
}

// Onboarding saga (Phase 3): each step recorded, resumable; nothing rolled back by deletion.
model OnboardingRun {
  id           String   @id @default(cuid())
  createdById  String
  prompt       String
  spec         Json
  plan         Json?
  status       String // DRAFT | CONFIRMED | RUNNING | FAILED | DONE
  steps        Json? // [{ key, status, at, error }]
  error        String?
  firmClientId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdById, createdAt])
}

model CommsDraft {
  id             String   @id @default(cuid())
  firmClientId   String
  jobTaskId      String?
  kind           String // status | doc-chase | due-reminder | filing-completed | query-response
  language       String   @default("en")
  subject        String
  body           String
  createdById    String
  outlookDraftId String? // draft in the staff member's own mailbox - never sent by the app
  createdAt      DateTime @default(now())

  @@index([firmClientId, createdAt])
}

model CoachEvent {
  id          String    @id @default(cuid())
  userId      String
  kind        String // board | reminder | escalation | break
  jobTaskId   String?
  payload     Json?
  dismissedAt DateTime?
  // Idempotency: e.g. "reminder:<jobTaskId>:<userId>:<istDay>". Concurrent cron runs cannot double-nudge.
  dedupeKey   String?   @unique
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([kind, createdAt])
  @@index([userId, kind, createdAt])
}

// -------------------- Firm OS: coach + hardening --------------------
// ActivityHeartbeat feeds the break nudge only (ADR-006): kept 7 days, aggregate only, never
// reported to managers. CoachPreference holds each person's own opt-outs. RateLimitBucket backs
// the Phase 11 rate limits on /onboard and agent runs.

model ActivityHeartbeat {
  id     String   @id @default(cuid())
  userId String
  at     DateTime @default(now())
  source String // lms | greythr

  @@index([userId, at])
  @@index([at])
}

model CoachPreference {
  userId       String    @id
  breakNudges  Boolean   @default(true)
  snoozeUntil  DateTime?
  morningBoard Boolean   @default(true)
  updatedAt    DateTime  @updatedAt
}

model RateLimitBucket {
  key         String   @id // "<scope>:<userId>"
  windowStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt
}

// -------------------- Firm OS: privacy rights, workspace, companion --------------------
// PrivacyRequest / BreachIncident: DPDP Act 2023 data-principal rights and breach handling
// (docs/dpdp/). Erasure is anonymisation or a recorded legal hold — never a hard delete.
// WorkspaceSetting / RoleWorkspaceDefault: admin-controlled modules and focus mode per user/role.
// CompanionToken: pairing for the read-only side-panel companion extension (hash only stored).

model PrivacyRequest {
  id             String   @id @default(cuid())
  kind           String // access | correction | erasure | grievance | nomination | consent-withdrawal
  principalType  String // client-person | client-contact | staff
  principalRef   String? // FirmClient.id / Client.id / User.id
  principalLabel String // masked display label only
  identifierHash String? // sha256 of normalised identifiers, for lookup without storing them again
  receivedAt     DateTime @default(now())
  dueAt          DateTime
  status         String // RECEIVED | VERIFYING | IN_PROGRESS | ON_HOLD | COMPLETED | REJECTED
  outcome        String?
  legalHold      String? // statutory basis when data must be retained
  handledById    String?
  createdById    String
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, dueAt])
  @@index([principalRef])
}

model BreachIncident {
  id                   String    @id @default(cuid())
  detectedAt           DateTime
  summary              String
  severity             String // low | medium | high
  affectedCount        Int?
  boardNotifiedAt      DateTime?
  principalsNotifiedAt DateTime?
  status               String // OPEN | CONTAINED | NOTIFIED | CLOSED
  createdById          String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status, detectedAt])
}

model WorkspaceSetting {
  userId           String   @id
  modules          Json? // null = role default; else array of module keys
  focusMode        Boolean?
  companionEnabled Boolean  @default(false)
  updatedById      String?
  updatedAt        DateTime @updatedAt
}

model RoleWorkspaceDefault {
  role        String   @id // admin | partner | manager | staff
  modules     Json
  focusMode   Boolean  @default(false)
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model CompanionToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  label      String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([userId])
}
