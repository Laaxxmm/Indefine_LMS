{
  "name": "lms-indefine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "node scripts/migrate.mjs && NODE_OPTIONS=\"--max-old-space-size=384 $NODE_OPTIONS\" next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "verify:certs": "tsx scripts/verify-certificate-templates.ts",
    "verify:engagement-letters": "tsx scripts/verify-engagement-letters.ts",
    "verify:clients": "tsx scripts/verify-clients.ts",
    "verify:client-ops": "tsx scripts/verify-client-ops.ts",
    "verify:work": "tsx scripts/verify-work.ts",
    "verify:access": "tsx scripts/verify-access.ts",
    "verify:cron-auth": "tsx scripts/verify-cron-auth.ts",
    "verify:secret-box": "tsx scripts/verify-secret-box.ts",
    "verify:graph-scopes": "tsx scripts/verify-graph-scopes.ts",
    "verify:office-tools": "tsx scripts/verify-office-tools.ts",
    "verify:profit-split": "tsx scripts/verify-profit-split.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "verify:no-skip": "tsx scripts/verify-no-skip.ts",
    "verify:secrets": "tsx scripts/verify-secrets.ts",
    "verify:no-portal": "tsx scripts/verify-no-portal.ts",
    "verify:no-delete": "tsx scripts/verify-no-delete.ts",
    "verify:ai-boundary": "tsx scripts/verify-ai-boundary.ts",
    "verify:firm-os": "npm run verify:no-skip && npm run verify:secrets && npm run verify:no-portal && npm run verify:no-delete && npm run verify:ai-boundary && npm run verify:ui-links && npm run verify:prompts && npm run verify:guardrail-profiles && npm run verify:rbac && npm run verify:audit-coverage",
    "verify:patha": "tsx --env-file-if-exists=.env.local scripts/verify-patha.ts",
    "map:legacy-folders": "tsx --env-file-if-exists=.env.local scripts/map-legacy-folders.ts",
    "e2e:db": "playwright test --config playwright.db.config.ts --repeat-each=3",
    "accuracy": "tsx scripts/accuracy.ts",
    "verify:ui-links": "tsx scripts/verify-ui-links.ts",
    "verify:prompts": "tsx scripts/verify-prompts.ts",
    "accuracy:canary": "tsx scripts/accuracy.ts --mode=live",
    "verify:rbac": "tsx scripts/verify-rbac.ts",
    "verify:audit-coverage": "tsx scripts/verify-audit-coverage.ts",
    "e2e:done-trigger": "playwright test --config playwright.db.config.ts done-trigger",
    "test:chaos": "vitest run tests/chaos",
    "test:regression": "vitest run tests/regression",
    "test:visual": "vitest run --config tests/regression/visual.vitest.config.ts",
    "e2e:db:list": "playwright test --config playwright.db.config.ts --list",
    "ai:guardrail-profiles": "tsx scripts/ai-guardrail-profiles.ts",
    "verify:guardrail-profiles": "tsx scripts/ai-guardrail-profiles.ts --check",
    "efficiency": "tsx scripts/efficiency-report.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@auth/prisma-adapter": "^2.7.4",
    "@prisma/client": "^6.1.0",
    "canvas-confetti": "^1.9.3",
    "docx": "^9.0.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.469.0",
    "next": "^15.5.4",
    "next-auth": "5.0.0-beta.32",
    "pdf-parse": "^2.4.5",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.4",
    "postcss": "^8.5.10",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
