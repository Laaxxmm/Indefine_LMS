# --- Database (Railway Postgres) ---
DATABASE_URL="postgresql://user:password@host:5432/lms?schema=public"

# --- NextAuth ---
AUTH_SECRET="run: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"
# In production set AUTH_URL to your Railway domain (https://...)
AUTH_TRUST_HOST="true"

# --- Microsoft Entra (Azure AD) App Registration ---
# Register an app in entra.microsoft.com -> App registrations
# Redirect URI: {AUTH_URL}/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"
# Encrypts stored Microsoft Graph access/refresh tokens at rest. 64 hex characters: openssl rand -hex 32
# Without it tokens are stored unencrypted and a warning is logged once per boot.
GRAPH_TOKEN_KEY=""

# --- Microsoft Graph (OneDrive video source) ---
# The ID of the shared OneDrive/SharePoint drive that holds the videos.
# Get via: GET https://graph.microsoft.com/v1.0/me/drive  OR  /sites/{site-id}/drives
GRAPH_DRIVE_ID=""
# Path to the videos folder *within the drive* (preferred — more robust).
# Example: "L&D" or "Training/2026". Just the path under the drive root.
GRAPH_VIDEOS_FOLDER_PATH=""
# Or, if you must use an item ID instead of a path, fill this:
GRAPH_VIDEOS_FOLDER_ID=""
# Client onboarding: top-level folder (single segment, directly under the drive root)
# that holds Clients/<Client>/… and Clients/_Database/Client Database.xlsx.
GRAPH_CLIENTS_ROOT="Clients"
# Tenant ID (same as above) — used for app-only Graph token if needed
MS_TENANT_ID=""
# Optional: client credentials for app-only Graph access (recommended for server-side listing)
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""

# --- App ---
ADMIN_EMAILS="admin@yourcompany.com"

# --- Tech work tracker (/work) ---
# Comma-separated emails allowed in. The first one is the lead (assigns, reviews, drops tasks).
# Nudges post to Teams as the lead; the lead must sign in once after deploy so the stored
# token carries Chat.Create and ChatMessage.Send.
WORK_TRACKER_EMAILS="lead@yourcompany.com,second@yourcompany.com"

# --- Live sessions (Teams recording auto-ingest) ---
# Shared secret for the recording-ingest cron endpoint. Generate a random value
# (e.g. openssl rand -hex 24). Schedule an every-15-min GET to
#   {AUTH_URL}/api/cron/live/ingest
# passing the secret as an Authorization header:  Authorization: Bearer $CRON_SECRET
CRON_SECRET=""

# --- Neo Centra (Turia incentive sync) ---
# Turia organization ID (GUID) — required, no fallback. Get it from a logged-in
# Turia session (the organizationId in its API payloads).
NEO_TURIA_ORG_ID=""
# Shared token the browser extension uses to push a fresh Turia cookie to the app.
NEO_TURIA_RELAY_TOKEN=""
# Encrypts the stored Turia cookie at rest. 64 hex characters: openssl rand -hex 32
# Without it the LMS refuses to store the cookie (Neo Centra keeps using the last one until it expires).
NEO_TURIA_COOKIE_KEY=""
# Set to 1 to expose the Neo Centra diagnostic endpoints (turia-debug, hours-debug). Leave unset in production.
NEO_CENTRA_DEBUG=""

# --- Gemini (AI quiz generator) ---
# Get a key at https://aistudio.google.com/app/apikey
# Optional — without it the "Generate with AI" panel on the admin video page is disabled.
GEMINI_API_KEY=""
# Optional. Leave BLANK to auto-detect a working model from your key
# (recommended — avoids "model not found" 404s if a name is retired).
# Only set this to force a specific model, e.g. "gemini-2.5-flash".
GEMINI_MODEL=""

# Statutory updates (Tools). Shared token the statutory-extension (office PC in India)
# uses to push the six portals that refuse non-Indian IPs. openssl rand -hex 32
STATUTORY_RELAY_TOKEN=""

# --- Firm OS: AI (ModelRouter) ---
# All cloud model calls go through src/lib/ai/router.ts, which masks client PII first.
# Claude (required for Firm OS agents). Create a key at console.anthropic.com.
ANTHROPIC_API_KEY=""
# Grok (xAI), optional: escalation / Claude-outage failover. Empty = Grok disabled.
XAI_API_KEY=""
# Local open-weight model (OpenAI-compatible /v1/chat/completions on the office LAN).
# Leave EMPTY this week: the local provider is a stub that fails closed (Phase 2b wires it).
LOCAL_LLM_BASE_URL=""
# Model name the local server exposes (Phase 2b). Default: local-open-weight
LOCAL_LLM_MODEL=""
# Claude model per tier. Defaults: claude-haiku-5-5 / claude-sonnet-5-5 / claude-opus-5-5
MODEL_FAST=""
MODEL_SMART=""
MODEL_HARD=""
# Grok model and its price in USD per million tokens (input / output). Defaults: grok-4, 3, 15
GROK_MODEL=""
GROK_PRICE_IN_USD_PER_MTOK=""
GROK_PRICE_OUT_USD_PER_MTOK=""
# Below this self-reported confidence the router escalates a tier. Default 0.75
ROUTER_MIN_CONF=""
# Cap on total model spend per IST calendar day, in rupees. Default 1000; 0 = no cap.
AI_DAILY_BUDGET_INR=""
# Rupees per US dollar for cost accounting. Default 88
USD_INR=""
# Output token cap per call (default 4096) and per-attempt timeout in ms (default 60000).
AI_MAX_OUTPUT_TOKENS=""
AI_TIMEOUT_MS=""
