# --- Database (Railway Postgres) ---
DATABASE_URL="postgresql://user:password@host:5432/lms?schema=public"

# --- NextAuth ---
AUTH_SECRET="run: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"
# In production set AUTH_URL to your Railway domain (https://...)
AUTH_TRUST_HOST="true"

# --- Microsoft Entra (Azure AD) App Registration ---
# Register an app in entra.microsoft.com -> App registrations
# Redirect URI: {AUTH_URL}/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"
# Encrypts stored Microsoft Graph access/refresh tokens at rest. 64 hex characters: openssl rand -hex 32
# REQUIRED in production: without it no Graph token is stored or read (sign-in still works; features
# that act as the person in Microsoft 365 are off) and an admin message is logged. Dev stores plaintext.
GRAPH_TOKEN_KEY=""
# Migration only: "true" lets rows written before a key existed (plaintext) be read while
# GRAPH_TOKEN_KEY / NEO_TURIA_COOKIE_KEY is set. Logged; turn it off once the rows are rewritten.
LEGACY_PLAINTEXT_SECRETS=""

# --- Microsoft Graph (OneDrive video source) ---
# The ID of the shared OneDrive/SharePoint drive that holds the videos.
# Get via: GET https://graph.microsoft.com/v1.0/me/drive  OR  /sites/{site-id}/drives
GRAPH_DRIVE_ID=""
# Path to the videos folder *within the drive* (preferred — more robust).
# Example: "L&D" or "Training/2026". Just the path under the drive root.
GRAPH_VIDEOS_FOLDER_PATH=""
# Or, if you must use an item ID instead of a path, fill this:
GRAPH_VIDEOS_FOLDER_ID=""
# Client onboarding: top-level folder (single segment, directly under the drive root)
# that holds Clients/<Client>/… and Clients/_Database/Client Database.xlsx.
GRAPH_CLIENTS_ROOT="Clients"
# Tenant ID (same as above) — used for app-only Graph token if needed
MS_TENANT_ID=""
# Optional: client credentials for app-only Graph access (recommended for server-side listing)
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""

# --- App ---
ADMIN_EMAILS="admin@yourcompany.com"

# --- Tech work tracker (/work) ---
# Comma-separated emails allowed in. The first one is the lead (assigns, reviews, drops tasks).
# Nudges post to Teams as the lead; the lead must sign in once after deploy so the stored
# token carries Chat.Create and ChatMessage.Send.
WORK_TRACKER_EMAILS="lead@yourcompany.com,second@yourcompany.com"

# --- Live sessions (Teams recording auto-ingest) ---
# Shared secret for the recording-ingest cron endpoint. Generate a random value
# (e.g. openssl rand -hex 24). Schedule an every-15-min GET to
#   {AUTH_URL}/api/cron/live/ingest
# passing the secret as an Authorization header:  Authorization: Bearer $CRON_SECRET
CRON_SECRET=""

# --- Neo Centra (Turia incentive sync) ---
# Turia organization ID (GUID) — required, no fallback. Get it from a logged-in
# Turia session (the organizationId in its API payloads).
NEO_TURIA_ORG_ID=""
# Shared token the browser extension uses to push a fresh Turia cookie to the app.
NEO_TURIA_RELAY_TOKEN=""
# Encrypts the stored Turia cookie at rest. 64 hex characters: openssl rand -hex 32
# Without it the LMS refuses to store the cookie (Neo Centra keeps using the last one until it expires).
NEO_TURIA_COOKIE_KEY=""
# Set to 1 to expose the Neo Centra diagnostic endpoints (turia-debug, hours-debug). Leave unset in production.
NEO_CENTRA_DEBUG=""

# --- Gemini (AI quiz generator) ---
# Get a key at https://aistudio.google.com/app/apikey
# Optional — without it the "Generate with AI" panel on the admin video page is disabled.
GEMINI_API_KEY=""
# Optional. Leave BLANK to auto-detect a working model from your key
# (recommended — avoids "model not found" 404s if a name is retired).
# Only set this to force a specific model, e.g. "gemini-2.5-flash".
GEMINI_MODEL=""

# Statutory updates (Tools). Shared token the statutory-extension (office PC in India)
# uses to push the six portals that refuse non-Indian IPs. openssl rand -hex 32
STATUTORY_RELAY_TOKEN=""

# --- Firm OS: AI (ModelRouter) ---
# All cloud model calls go through src/lib/ai/router.ts, which masks client PII first.
# Claude (required for Firm OS agents). Create a key at console.anthropic.com.
ANTHROPIC_API_KEY=""
# Grok (xAI), optional: escalation / Claude-outage failover. Empty = Grok disabled.
XAI_API_KEY=""
# Local open-weight model (OpenAI-compatible /v1/chat/completions on the office LAN).
# Leave EMPTY this week: the local provider is a stub that fails closed (Phase 2b wires it).
LOCAL_LLM_BASE_URL=""
# Model name the local server exposes (Phase 2b). Default: local-open-weight
LOCAL_LLM_MODEL=""
# Claude model per tier. Defaults: claude-haiku-5-5 / claude-sonnet-5-5 / claude-opus-5-5
MODEL_FAST=""
MODEL_SMART=""
MODEL_HARD=""
# Grok model and its price in USD per million tokens (input / output). Defaults: grok-4, 3, 15
GROK_MODEL=""
GROK_PRICE_IN_USD_PER_MTOK=""
GROK_PRICE_OUT_USD_PER_MTOK=""
# Below this self-reported confidence the router escalates a tier. Default 0.75
ROUTER_MIN_CONF=""
# Cap on total model spend per IST calendar day, in rupees. Default 1000; 0 = no cap.
AI_DAILY_BUDGET_INR=""
# Rupees per US dollar for cost accounting. Default 88
USD_INR=""
# Output token cap per call (default 4096) and per-attempt timeout in ms (default 60000).
AI_MAX_OUTPUT_TOKENS=""
AI_TIMEOUT_MS=""

# --- Firm OS: task agents ---
# Show the internal Echo framework-test agent on /agents (staging / demos). Default OFF.
FIRM_OS_ECHO_AGENT=""

# --- Firm OS: Daily Coach ---
# Break nudges (ADR-006): LMS activity heartbeats, kept 7 days, never reported to managers. Default OFF;
# tell staff what is collected before turning it on.
FIRM_OS_BREAK_NUDGE=""
# Firm holidays the coach skips when counting working days, comma-separated YYYY-MM-DD. The LMS has no
# holiday table; blank = weekends only.
FIRM_OS_HOLIDAYS=""

# --- Firm OS: SharePoint Path A ---
# docs/folder-contract.md. Feature flag: /clients folder links resolve to CL-{Code} sites.
# Default OFF; 1/true/on/yes turns it on. Legacy GRAPH_CLIENTS_ROOT layout stays readable either way.
FIRM_OS_CL_PATHS=""
# Tenant SharePoint host. Blank = srcaassociate.sharepoint.com
SP_TENANT_HOST=""
# Hub that every CL- site joins. Blank = https://<SP_TENANT_HOST>/sites/Indefine-Compliance
SP_HUB_SITE_URL=""
# Entra tenant id or domain for the PnP certificate token. Blank = MS_TENANT_ID, then <tenant>.onmicrosoft.com
SP_TENANT_ID=""
# PnP app registration (SharePoint Sites.FullControl.All, admin consented). Blank = 381abf0e-e427-417f-9b45-651e8ca823ec
SP_PNP_CLIENT_ID=""
# Private key (PEM) of the certificate uploaded to the PnP app. One line with \n escapes is fine.
SP_PNP_CERT_KEY_PEM=""
# Passphrase for SP_PNP_CERT_KEY_PEM, only if the key is encrypted.
SP_PNP_CERT_KEY_PASSPHRASE=""
# The matching public certificate (PEM). Thumbprints are derived from it. Either this...
SP_PNP_CERT_PEM=""
# ...or the certificate's SHA-1 thumbprint (40 hex characters) when the PEM is not supplied.
SP_PNP_CERT_THUMBPRINT=""
# UPN made owner of new CL- sites (SharePoint requires an owner for app-only site creation).
SP_SITE_OWNER=""

# --- Firm OS: flags and tuning (documented for go-live; all optional) ---
# Master switch. Default OFF: Firm OS is closed for everyone — no Firm OS link, card or query on any LMS
# page; Firm OS pages send people to the dashboard and Firm OS APIs answer 404, both with a plain sentence;
# the workspace settings are not read. Only /admin/firm-os/workspace stays open so the rollout can be set
# up first. 1/true/on/yes = on: the workspace module settings decide per role and person. Pilot: save role
# defaults without the Firm OS modules, set this to 1, then switch the modules on for the pilot people
# (docs/go-live.md §3).
FIRM_OS_ENABLED=""
# Onboarding: true = a partner/manager must click "Create" before anything is set up.
FIRM_OS_ONBOARD_CONFIRM="true"
# Turia bridge: MANUAL (default; ADR-003) | UI (dry-run automation, partner-only, off unless FIRM_OS_TURIA_UI=true)
FIRM_OS_TURIA_BRIDGE="MANUAL"
FIRM_OS_TURIA_UI=""
# Drift monitoring thresholds (fractions, 0–1) for /admin/firm-os/models; blank = defaults.
GUARDRAIL_MAX_SCHEMA_FAIL_RATE=""
GUARDRAIL_MAX_ESCALATION_RATE=""
GUARDRAIL_MAX_ABSTAIN_RATE=""
GUARDRAIL_MAX_UNGROUNDED_RATE=""
GUARDRAIL_MAX_DISAGREEMENT_RATE=""
GUARDRAIL_MAX_OVERRIDE_RATE=""
GUARDRAIL_MIN_SAMPLE=""
# Companion extension origin(s), comma-separated chrome-extension://<id>; blank = the fixed ID in the manifest.
FIRM_OS_COMPANION_EXTENSION_ORIGIN=""

# --- Firm OS hardening: rate limits (optional; blank = the default in brackets) ---
# "<requests>/<window>", window in s, m or h. Counted per person (per pairing token for the
# Companion) in the RateLimitBucket table, shared by every app instance. Changing a limit is a
# threshold change: partner decision (src/lib/rbac/policy.ts canChangeThresholds).
# Plain-English onboarding requests [30/1h]
RATE_LIMIT_ONBOARD=""
# Agent runs, re-runs and change requests [20/1h]
RATE_LIMIT_AGENT_RUN=""
# Client comms drafts [30/1h]
RATE_LIMIT_COMMS_DRAFT=""
# Searches by full PAN, GSTIN, phone or email [10/10m]
RATE_LIMIT_IDENTIFIER_SEARCH=""
# Companion side-panel refreshes, per pairing token [20/1m]
RATE_LIMIT_COMPANION=""
